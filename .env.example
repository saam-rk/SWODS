# Required for every production build. Use the hosted project's HTTPS URL and
# public anonymous/publishable key. Local development can omit both to use demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production for expiring memory links. Server-only: never prefix
# this value with NEXT_PUBLIC_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional release identifier shown by /api/health (for example, a commit SHA).
APP_RELEASE=
